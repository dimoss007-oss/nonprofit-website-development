{
  "tests": [
    {
      "name": "Неверный логин",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "login": "wrong",
        "password": "wrong"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Публичный список",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Полный список без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "list_full"
      },
      "expectedStatus": 403
    },
    {
      "name": "Сброс: неизвестный логин не раскрывается",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_reset",
        "login": "no_such_user_xyz"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Подтверждение сброса с неверным кодом",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "confirm_reset",
        "login": "no_such_user_xyz",
        "code": "000000",
        "new_password": "abcdef"
      },
      "expectedStatus": 400
    },
    {
      "name": "Журнал входов без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login_log",
        "auth_login": "x",
        "auth_password": "y"
      },
      "expectedStatus": 403
    },
    {
      "name": "Код входа: неизвестный логин",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_login_code",
        "login": "nobody-xyz"
      },
      "expectedStatus": 200
    },
    {
      "name": "Код входа: неверный код",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "confirm_login_code",
        "login": "nobody-xyz",
        "code": "000000"
      },
      "expectedStatus": 400
    }
  ]
}