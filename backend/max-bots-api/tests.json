{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестный бот отклоняется",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 404
    },
    {
      "name": "bot=contact — неизвестный update игнорируется",
      "method": "POST",
      "path": "/?bot=contact",
      "body": {"update_type": "unknown"},
      "expectedStatus": 200
    },
    {
      "name": "bot=tasks — неизвестный update игнорируется",
      "method": "POST",
      "path": "/?bot=tasks",
      "body": {"update_type": "unknown"},
      "expectedStatus": 200
    },
    {
      "name": "bot=finance — пустое тело возвращает ok",
      "method": "POST",
      "path": "/?bot=finance",
      "body": {},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "bot=shift-report — без секрета отклоняется",
      "method": "POST",
      "path": "/?bot=shift-report",
      "body": {"update_type": "message", "message": {"sender": {"user_id": "1"}, "body": {"text": "1. Света Л молодец"}}},
      "expectedStatus": 401
    }
  ]
}
