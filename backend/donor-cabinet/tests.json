{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Кабинет без входа",
      "method": "GET",
      "path": "/?view=overview",
      "expectedStatus": 401
    },
    {
      "name": "Публичные уровни и достижения",
      "method": "GET",
      "path": "/?view=public",
      "expectedStatus": 200,
      "expectedBody": {},
      "bodyMatcher": "keys"
    },
    {
      "name": "Код: неверный email",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_code",
        "email": "abc"
      },
      "expectedStatus": 400
    },
    {
      "name": "Проверка кода: нет данных",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify_code"
      },
      "expectedStatus": 400
    },
    {
      "name": "Админ-действие без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_overview"
      },
      "expectedStatus": 403
    },
    {
      "name": "Отчёт сбора без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_goal_report_send",
        "goal_id": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Топ историй",
      "method": "GET",
      "path": "/?view=top_stories",
      "expectedStatus": 200,
      "expectedBody": {
        "stories": []
      },
      "bodyMatcher": "keys"
    },
    {
      "name": "Галерея благодарностей",
      "method": "GET",
      "path": "/?view=gratitude",
      "expectedStatus": 200,
      "expectedBody": {
        "posts": []
      },
      "bodyMatcher": "keys"
    },
    {
      "name": "Благодарность без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_gratitude_save"
      },
      "expectedStatus": 403
    },
    {
      "name": "Видеоотчёты",
      "method": "GET",
      "path": "/?view=videos",
      "expectedStatus": 200,
      "expectedBody": {
        "videos": []
      },
      "bodyMatcher": "keys"
    },
    {
      "name": "Видео без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_video_save"
      },
      "expectedStatus": 403
    },
    {
      "name": "Мобильная бригада",
      "method": "GET",
      "path": "/?view=brigade",
      "expectedStatus": 200,
      "expectedBody": {
        "stats": {}
      },
      "bodyMatcher": "keys"
    },
    {
      "name": "Бригада без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_brigade_stats_save"
      },
      "expectedStatus": 403
    },
    {
      "name": "Годовой отчёт без прав",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_annual_draft"
      },
      "expectedStatus": 403
    }
  ]
}